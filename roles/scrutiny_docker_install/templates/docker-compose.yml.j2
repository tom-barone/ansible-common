services:
  scrutiny:
    image: "ghcr.io/analogj/scrutiny:{{ scrutiny_docker_install_version }}"
    container_name: "{{ scrutiny_docker_install_container_name }}"
    restart: "unless-stopped"
    cap_add:
      - "SYS_ADMIN"
      - "SYS_RAWIO"
    ports:
      - "{{ scrutiny_docker_install_port }}:8080"
    volumes:
      - "/run/udev:/run/udev:ro"
      - "{{ scrutiny_docker_install_dir }}/config:/opt/scrutiny/config"
      - "{{ scrutiny_docker_install_dir }}/influxdb:/opt/scrutiny/influxdb"
{% if _scrutiny_docker_install_devices | length > 0 %}
    # The collector lowercases device paths, so map each disk to the
    # lowercased path. Long syntax because by-id names can contain ":".
    devices:
{% for d in _scrutiny_docker_install_devices %}
      - source: "{{ d.device }}"
        target: "{{ d.device | lower }}"
        permissions: "rwm"
{% endfor %}
{% endif %}
