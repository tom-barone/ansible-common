services:
  postgres:
    image: "{{ postgres_pgbackrest_install_image }}"
    container_name: "{{ postgres_pgbackrest_install_container_name }}"
    restart: "unless-stopped"
    command:
      - "postgres"
      - "-c"
      - "archive_mode=on"
      - "-c"
      - >-
        archive_command=pgbackrest
        --stanza={{ postgres_pgbackrest_install_stanza }}
        archive-push %p
{% if postgres_pgbackrest_install_pgbouncer_enabled %}
    expose:
      - "5432"
{% else %}
    ports:
      - "127.0.0.1:{{ postgres_pgbackrest_install_port }}:5432"
{% endif %}
    volumes:
      - "{{ postgres_pgbackrest_install_dir }}/data:{{ postgres_pgbackrest_install_data_dir }}"
      - "{{ postgres_pgbackrest_install_dir }}/pgbackrest.conf:/etc/pgbackrest/pgbackrest.conf:ro"
    environment:
      POSTGRES_USER: "{{ postgres_pgbackrest_install_user }}"
      POSTGRES_PASSWORD: "{{ postgres_pgbackrest_install_password }}"
{% if postgres_pgbackrest_install_initdb_args %}
      POSTGRES_INITDB_ARGS: "{{ postgres_pgbackrest_install_initdb_args }}"
{% endif %}

{% if postgres_pgbackrest_install_pgbouncer_enabled %}
  pgbouncer:
    image: "edoburu/pgbouncer:{{ postgres_pgbackrest_install_pgbouncer_version }}"
    container_name: "{{ postgres_pgbackrest_install_pgbouncer_container_name }}"
    restart: "unless-stopped"
    depends_on:
      - "postgres"
    ports:
      - "127.0.0.1:{{ postgres_pgbackrest_install_port }}:6432"
    environment:
      DB_HOST: "{{ postgres_pgbackrest_install_container_name }}"
      DB_PORT: "5432"
      DB_USER: "{{ postgres_pgbackrest_install_user }}"
      DB_PASSWORD: "{{ postgres_pgbackrest_install_password }}"
      DB_NAME: "*"
      AUTH_TYPE: "scram-sha-256"
      POOL_MODE: "{{ postgres_pgbackrest_install_pgbouncer_pool_mode }}"
      ADMIN_USERS: "{{ postgres_pgbackrest_install_user }}"
      LISTEN_PORT: "6432"
      MAX_CLIENT_CONN: "{{ postgres_pgbackrest_install_pgbouncer_max_client_conn }}"
      DEFAULT_POOL_SIZE: "{{ postgres_pgbackrest_install_pgbouncer_default_pool_size }}"
    healthcheck:
      test: ["CMD", "pg_isready", "-h", "localhost", "-p", "6432", "-U", "{{ postgres_pgbackrest_install_user }}"]
      interval: "10s"
      timeout: "5s"
      retries: 5
{% endif %}

networks:
  default:
    name: "{{ postgres_pgbackrest_install_network }}"
    external: true
