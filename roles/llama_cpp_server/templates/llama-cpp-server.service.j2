# AI GENERATED - Tom Barone
[Unit]
Description=llama.cpp server
After=network-online.target
Wants=network-online.target
RequiresMountsFor={{ llama_cpp_server_cache_dir }}

[Service]
Type=simple
User=llama-cpp-server
Group=llama-cpp-server
Environment="LLAMA_CACHE={{ llama_cpp_server_cache_dir }}"
{% if llama_cpp_server_backend == 'cuda' %}
# Nothing creates /dev/nvidia-uvm at boot. CUDA would create it with the
# setuid nvidia-modprobe, which NoNewPrivileges blocks, so create it here
# as root (+). Without it, CUDA fails and llama.cpp falls back to the CPU.
ExecStartPre=+/usr/bin/nvidia-modprobe -u -c=0
{% endif %}
ExecStart={{ llama_cpp_server_dir }}/llama-server \
    --models-preset /etc/llama-cpp-server/models.ini \
    --host {{ llama_cpp_server_host }} \
    --port {{ llama_cpp_server_port }}{% for arg in llama_cpp_server_args %} \
    {{ arg }}{% endfor %}

Restart=on-failure

# Security hardening. PrivateDevices is left out so the GPU stays visible.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ llama_cpp_server_cache_dir }}

[Install]
WantedBy=multi-user.target
